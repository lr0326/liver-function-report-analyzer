# Flask settings
FLASK_ENV=development
DEBUG=True
SECRET_KEY=change-this-secret-key-in-production

# File upload settings
UPLOAD_FOLDER=/tmp/uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB

# OpenAI settings
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Local LLM settings (Ollama-compatible, alternative to OpenAI)
USE_LOCAL_LLM=False
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3

# OCR settings
OCR_LANGUAGE=ch   # 'ch' enables Chinese + English recognition
OCR_USE_GPU=False

# Database
DATABASE_URL=sqlite:///liver_analyzer.db

# Analysis output language
ANALYSIS_LANGUAGE=zh
